{
  "name": "speedroller-multiplayer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch main.mts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/multiplayer/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node validate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ws": "8.22.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
