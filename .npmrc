# @react-three/rapier@2.2.0 peers @react-three/fiber@^9, but the project runs the R3F v10 alpha
# for its WebGPU renderer. The Threenix landing app runs this exact pairing in production
# (including InstancedRigidBodies), so the runtime is proven; only the peer range is stale.
# Revisit when rapier publishes a v10 line.
legacy-peer-deps=true
